graphName carplay_spoken_audio

; I/O
in in
out out

; Boxes
box NFP nfnp 1 1 ; Non Finite Protection
box AUControlFreak_1 (aufx cfrk appl) 1 1
box AUControlFreak_2 (aufx cfrk appl) 1 1
box SPLMeter (aufx splm appl) 1 1

box LKFSSmoothing parameter_smoothing 1 0



; Formats
format inputFormat (48000 2)
format outputFormat (48000 2)


; Wires
wire (in 0) (NFP 0) inputFormat
wire (NFP 0) (AUControlFreak_1 0) inputFormat
wire (AUControlFreak_1 0) (AUControlFreak_2 0) inputFormat
wire (AUControlFreak_2 0) SPLMeter inputFormat
wire SPLMeter (out 0) outputFormat

wire SPLMeter LKFSSmoothing inputFormat



; Parameters

; disable dbA
param edba 0 const
wireGraphParam edba (SPLMeter 2)

; enable LKFS
param ekfs 1 const
wireGraphParam ekfs (SPLMeter 6)

; spl LKFS
param atck 5
wireGraphParam atck (LKFSSmoothing 0 global 0)
param rels 18
wireGraphParam rels (LKFSSmoothing 1 global 0)

; smoothed LKFS 
param skfs 0 out
wireParam (SPLMeter 7) (LKFSSmoothing 0 input 0)
wireGraphParam skfs (LKFSSmoothing 0 output 0)
